load(":qt_toolchain.bzl", "qt_toolchain")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

qt_toolchain(
    name = "qt_linux",
    moc = "@qt_linux_x86_64//:moc",
    rcc = "@qt_linux_x86_64//:rcc",
    uic = "@qt_linux_x86_64//:uic",
)

qt_toolchain(
    name = "qt_linux_aarch64",
    moc = "@qt_linux_aarch64//:moc",
    rcc = "@qt_linux_aarch64//:rcc",
    uic = "@qt_linux_aarch64//:uic",
)

qt_toolchain(
    name = "qt_osx",
    moc = "@qt_mac_x86_64//:moc",
    rcc = "@qt_mac_x86_64//:rcc",
    uic = "@qt_mac_x86_64//:uic",
)

qt_toolchain(
    name = "qt_osx_M1",
    moc = "@qt_mac_aarch64//:moc",
    rcc = "@qt_mac_aarch64//:rcc",
    uic = "@qt_mac_aarch64//:uic",
)

qt_toolchain(
    name = "qt_windows",
    moc = "@qt_windows_x86_64//:moc",
    rcc = "@qt_windows_x86_64//:rcc",
    uic = "@qt_windows_x86_64//:uic",
)

toolchain(
    name = "qt_linux_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":qt_linux",
    toolchain_type = ":toolchain_type",
)

toolchain(
    name = "qt_linux_aarch64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":qt_linux_aarch64",
    toolchain_type = ":toolchain_type",
)

# Qt for macOS consists of universal binaries - its tools run on arm64 and x86_64
toolchain(
    name = "qt_osx_toolchain",
    exec_compatible_with = [
        "@platforms//os:osx",
    ],
    target_compatible_with = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":qt_osx",
    toolchain_type = ":toolchain_type",
)

toolchain(
    name = "qt_osx_M1_toolchain",
    exec_compatible_with = [
        "@platforms//os:osx",
    ],
    target_compatible_with = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":qt_osx_M1",
    toolchain_type = ":toolchain_type",
)

toolchain(
    name = "qt_windows_toolchain",
    exec_compatible_with = [
        "@platforms//os:windows",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":qt_windows",
    toolchain_type = ":toolchain_type",
)
