module(
    name = "rules_qt",
    version = "0.0.8",
    bazel_compatibility = [">=8.0.0"],
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")

# Creates the Qt repositories (with the newest supported Qt LTS release by default).
# The root module can select another Qt version via `qt.install(version = ...)`.
qt = use_extension("//extension:qt.bzl", "fetch")
use_repo(qt, "qt_linux_aarch64", "qt_linux_x86_64", "qt_mac_aarch64", "qt_mac_x86_64", "qt_windows_x86_64")

register_toolchains("//tools:all")
