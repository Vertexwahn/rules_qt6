# Settings for the current platform are applied automatically (e.g. build:windows on Windows)
common --enable_platform_specific_config

# Linux (GCC or Clang)
build:linux --cxxopt=-std=c++20
build:linux --cxxopt=-Wall

# macOS (Apple Clang)
build:macos --cxxopt=-std=c++20
build:macos --cxxopt=-Wall

# Windows (Visual Studio 2022 or newer)
build:windows --cxxopt=/std:c++20
build:windows --cxxopt=/Zc:__cplusplus
build:windows --enable_runfiles # https://github.com/bazelbuild/bazel/issues/8843
build:windows --copt=-DWIN32_LEAN_AND_MEAN
build:windows --copt=-DNOGDI
build:windows --host_copt=-DWIN32_LEAN_AND_MEAN
build:windows --host_copt=-DNOGDI

# Former config names - not needed anymore
build:gcc11 --config=linux
build:gcc13 --config=linux
build:vs2019 --config=windows
build:vs2022 --config=windows
build:vs2026 --config=windows
